{
  "name": "mewbook-landing",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Landing page of MewBook (Mèo Mực). Content comes from content.json, refreshed by scripts/update-content.js.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "update-content": "node scripts/update-content.js",
    "test": "node --test scripts/update-content.test.js",
    "update-content:commit": "node scripts/update-content.js --commit"
  },
  "dependencies": {
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
