# Never commit credentials. The app reads these from %APPDATA%/SmartDocLibrary
# by default, never from inside the repo, but this is defense in depth in
# case one ever gets dropped in here by mistake.
service_account*.json
credentials.json
token.json
*.pem
*.key

# Generated by packaging/build.ps1 from eula_dialog.EULA_TEXT
packaging/EULA.txt

# The author's personal planning/spec documents (and their Markdown
# conversions) -- kept on disk, deliberately not published.
SmartDoc_Library_Dac_ta_tong_hop_1.docx
Upgrade smart doc.docx
ebook manager*.pdf
docs/ebook manager*.md

# Brand artwork sources: provenance/licence not yet confirmed (see
# docs/handoff/DISCREPANCIES.md, item 15); packaged copies come later.
Sample theme/
REQ/

# The app's own per-user data files. They live in %APPDATA%/SmartDocLibrary,
# outside this repo, so these are defense in depth against a copy landing here.
identity.dat
.supabase_url
.supabase_anon_key
settings.json
*.log

# The author's personal bank QR for the donate popup. Deliberately not in the
# repo: packaging/MewBook.spec bundles it only if the file exists, and the
# popup falls back to plain text without it (see donate_dialog.py).
src/smartdoc/presentation/assets/donate_qr.png

# Draft daily error-triage summaries (tools/triage): local until the owner decides to keep one.
docs/triage/

# Tool caches, IDE folders, local environment variants and dependency folders
# (defense in depth: none of these belong in the repo).
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.vscode/
.idea/
.env.*
!.env.example
.DS_Store
Thumbs.db
node_modules/

# Installer output copies and social-media artwork: large binaries, not source
# (provenance of the artwork is unconfirmed, same as Sample theme/ above).
Setup/
Social/

# Theme packages waiting to be imported / already imported (themes/incoming); the imported theme lives in themes/<id>/
themes/incoming/*.zip
themes/incoming/_da-nhap/*.zip
layouts/incoming/*.zip
layouts/incoming/_da-nhap/*.zip

# dev tool outputs
report.json
