{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mewbook.local/layout.schema.json",
  "title": "MewBook layout package — layout.json",
  "description": "Kiểu giao diện (bố cục, hình khối, mật độ). Kiểu giao diện là MÃ được cài một lần; file này mô tả thông số và danh sách theme dùng được kèm màu chỉnh riêng.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "version",
    "content_surface",
    "metrics",
    "ornaments",
    "default_theme",
    "themes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "name": {
      "type": "string",
      "maxLength": 32
    },
    "description": {
      "type": "string",
      "maxLength": 90
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "author": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "inspired_by": {
      "type": "string"
    },
    "content_surface": {
      "enum": [
        "bg",
        "panel"
      ],
      "description": "Nền mà lưới bìa/danh sách nằm trên. Kệ sách = bg; Tối giản = panel (tấm nền bo góc). Validator dùng nền này để kiểm tra accent."
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean"
        ]
      },
      "description": "Số đo của kiểu: bo góc, mật độ, cỡ chữ tiêu đề… (px). Xem bảng trong LAYOUT_SPEC.md."
    },
    "ornaments": {
      "enum": [
        "apply",
        "ignore"
      ],
      "description": "ignore = bỏ qua khối ornaments của theme (gỗ, bảng phấn…) khi ở kiểu này."
    },
    "default_theme": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "themes": {
      "type": "object",
      "minProperties": 1,
      "description": "Theme dùng được với kiểu này (ngoài những theme tự khai báo layouts trong theme.json). Giá trị = token chỉnh riêng (có thể rỗng).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 40,
            "description": "Ghi chú ngắn hiện dưới thẻ theme, vd. 'Mặc định' hoặc 'Gần ảnh mẫu nhất'."
          },
          "tokens": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "preview": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}